# Copy to .env and fill in as needed.

# --- Database (MySQL 8) ------------------------------------------------------
# The app connects to a MySQL server. See docs/DATABASE.md for one-time setup.
AR_DB_URL=mysql+pymysql://ar_user:ar_password@localhost:3306/ar_platform
# Test suite uses a separate database so it never touches your working data:
AR_TEST_DB_URL=mysql+pymysql://ar_user:ar_password@localhost:3306/ar_platform_test

# --- LLM backend ------------------------------------------------------------
# "rules" (default): fully deterministic — fixed dunning templates, no API key,
#   no LLM anywhere. Honest baseline mode.
# "claude": real Claude API calls for personalized drafting (and the agentic
#   layer: reply understanding + negotiation). Requires ANTHROPIC_API_KEY.
AR_LLM_MODE=rules

# Only needed when AR_LLM_MODE=claude
ANTHROPIC_API_KEY=
AR_CLAUDE_MODEL=claude-sonnet-5

# Reproducibility: seed for synthetic data + simulation randomness
AR_SEED=42
